# Copy this file to .env and change the values. .env is ignored by git.

# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me

# True only on your own machine.
DJANGO_DEBUG=True

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# SLA timers use this time zone.
DJANGO_TIME_ZONE=Australia/Melbourne

# Optional: "Sign in with Google". Leave empty to hide the button.
# How to get these: docs/GOOGLE_SIGN_IN.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: send real emails (sign-up verification, password reset). Without this they are
# printed in the terminal that runs `python manage.py runserver`.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
